modules = ["python-3.12"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd gamehub && python main.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8000
externalPort = 80

[userenv]

[userenv.shared]
ADMIN_ID = "5756096918"
AI_ANALYZE_MODEL = "qwen/qwen3-coder:free"
AI_AUTO_SELECT = "False"
AI_CHAT_MODEL = "qwen/qwen3-coder:free"
AI_CODE_MODEL = "qwen/qwen3-coder:free"
AI_DEVELOPER = "True"
AI_FIX_MODEL = "qwen/qwen3-coder:free"
AI_GAME_MODEL = "qwen/qwen3-coder:free"
AI_MODEL = "qwen/qwen3-coder:free"
AI_PREVIEW = "True"
AI_PROVIDER = "openrouter"
AUTO_APPLY = "False"
AUTO_BACKUP = "True"
AUTO_GITHUB_PUSH = "False"
BACKUP_MANAGER = "True"
BOT_USERNAME = "Kichik_oyinlar_bot"
DATABASE_MANAGER = "True"
DEBUG = "False"
DEVELOPER_MODE = "True"
ENVIRONMENT = "development"
FILE_MANAGER = "True"
