# ─────────────────────────────────────────────────────────────────────────────
# Kichik Oyinlar Bot — environment variable reference
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=Kichik_oyinlar_bot   # without @

# ── PostgreSQL (Neon or any Postgres-compatible provider) ─────────────────────
# Two separate databases are supported; both can point to the same instance.
GLOBAL_DATABASE_URL=postgresql://user:password@host/global_db?sslmode=require
GAME_DATABASE_URL=postgresql://user:password@host/game_db?sslmode=require

# ── Web Application ───────────────────────────────────────────────────────────
# The public HTTPS URL this service is reachable at.
# Render:  https://<your-app>.onrender.com
# Replit:  leave blank — auto-detected from REPLIT_DEV_DOMAIN
WEBAPP_URL=https://your-app.onrender.com

# ── Server ────────────────────────────────────────────────────────────────────
# Render injects PORT automatically (usually 10000).
# Leave blank for Replit / local dev (defaults to 8000).
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string
SECRET_KEY=change_me_to_another_long_random_string

# ── Feature Flags ─────────────────────────────────────────────────────────────
DEVELOPER_MODE=false   # true enables /developer admin commands

# ── AI Developer Module (optional) ───────────────────────────────────────────
# AI_PROVIDER=gemini                    # openai | gemini | openrouter | claude | deepseek
# AI_MODEL=gemini-1.5-pro
# AI_API_KEY=your_api_key_here

# ── GitHub Integration (optional) ────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxx
# GITHUB_OWNER=your_github_username
# GITHUB_REPO=your_repo_name
# GITHUB_BRANCH=main

# ── Deployment marker (set automatically by render.yaml) ─────────────────────
# RENDER=true
