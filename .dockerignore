# Version control
.git
.gitignore
.gitattributes

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets — never bake into image
.env
*.env.local
*.env.production

# Replit-specific files
.replit
replit.nix
.upm/
.cache/
.local/
.agents/

# Runtime artefacts (rebuilt inside container)
gamehub/logs/
gamehub/backups/
gamehub/__pycache__/
gamehub/**/__pycache__/

# Documentation / config not needed at runtime
*.md
!gamehub/replit.md
render.yaml

# OS noise
.DS_Store
Thumbs.db
